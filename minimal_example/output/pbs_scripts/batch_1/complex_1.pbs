!/bin/bash  
#PBS -N boltz_prediction_1  
#PBS -l nodes=1:ppn=8,gpus=1  
#PBS -l walltime=0:30:0  
#PBS -l mem=64gb  

module load Boltz-1/0.4.1-foss-2023a-CUDA-12.1.1  


# Create output directory
mkdir -p /path/on/hpc/boltz_dimer_job/predictions/complex_1

# Set environment variable for CPU fallback if needed


# Make sure MSA and YAML files are available on HPC server

# Run Boltz prediction
boltz predict "/path/on/hpc/boltz_dimer_job/yaml_files/complex_1.yaml" \
    --out_dir "/path/on/hpc/boltz_dimer_job/predictions/complex_1" \
    --recycling_steps 3 \
    --diffusion_samples 1 \
    --devices 1 \
    --cache /path/on/hpc/boltz_dimer_job/cache
